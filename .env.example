# Secrets live in Doppler (project there_will_be_cinema, config dev). This file lists the
# variables the backend reads; do not put real values here.
EMBY_SERVER_URL=https://emby.example.com
EMBY_SERVER_API=changeme
ADMIN_TOKEN=changeme
# Optional overrides (defaults shown)
# EMBY_PUBLIC_URL=            # defaults to EMBY_SERVER_URL
# CLUB_URL=https://criterion.therewillbecinema.com/movie-club
# DATA_DIR=./data
# SYNC_INTERVAL_HOURS=6
# LOG_LEVEL=INFO
# LOG_JSON=false
# FRONTEND_ORIGIN=http://localhost:5173
# Movie club sign-in (Emby accounts). Sign-in is off until SESSION_SECRET is set.
# SESSION_SECRET=             # long random string; rotating it signs everyone out
# CLUB_ADMINS=                # comma-separated Emby usernames allowed into /club/admin
# SECURE_COOKIES=false        # true in production (https)
